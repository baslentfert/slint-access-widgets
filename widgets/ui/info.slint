// SPDX-License-Identifier: MIT OR Apache-2.0
//
// An ⓘ button that shows an explanation (a "toggletip"): opens on click,
// Enter or Space, not only on hover, so it works with a keyboard, a touch
// screen and a screen reader. When it opens, the explanation is announced
// (a status message) while the focus stays on the button; the button says
// whether it is expanded. WCAG 1.4.13: Escape or a click elsewhere closes
// it, the mouse can move onto it, and it stays until closed.

import { Palette } from "std-widgets.slint";
import { AccessFocus } from "focus.slint";
import { AccessAnnouncer } from "cells.slint";

// The size of the window, for placing popups well (the ⓘ explanation).
// Set it from your window:
//     init => { AccessWindow.width = self.width; AccessWindow.height = self.height; }
//     changed width => { AccessWindow.width = self.width; }
//     changed height => { AccessWindow.height = self.height; }
export global AccessWindow {
    in-out property <length> width;
    in-out property <length> height;
}

export global AccessInfoTexts {
    pure public function more-about(topic: string) -> string {
        @tr("access-widgets" => "More about {}", topic)
    }
}

export component AccessInfo inherits Rectangle {
    // What it is about, e.g. "Clipboard": the button is called "More about
    // Clipboard".
    in property <string> about;
    // The explanation.
    in property <string> text;
    out property <bool> is-open: open;

    // Follows the popup, also when a click elsewhere closed it.
    property <bool> open: bubble.is-open;

    public function show() {
        if (open) { return; }
        bubble.show();
        // A popup takes the focus; it belongs on the button.
        fs.focus();
        news.say(text);
    }
    public function close() {
        if (!open) { return; }
        bubble.close();
    }

    // 24 × 24 px at least (WCAG 2.5.8).
    width: 24px;
    height: 24px;

    accessible-role: button;
    accessible-label: AccessInfoTexts.more-about(about);
    accessible-expandable: true;
    accessible-expanded: open;
    // While open, the explanation is also its description: read again when
    // the button gets focus.
    accessible-description: open ? text : "";
    accessible-action-default => { if (open) { close(); } else { show(); } }

    fs := FocusScope {
        capture-key-pressed(e) => {
            AccessFocus.keyboard = true;
            reject
        }
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) { AccessFocus.keyboard = true; }
        }
        key-pressed(e) => {
            if (e.text == Key.Return || e.text == " ") {
                if (open) { close(); } else { show(); }
                return accept;
            }
            if (e.text == Key.Escape && open) { close(); return accept; }
            reject
        }
    }
    touch := TouchArea {
        clicked => {
            AccessFocus.keyboard = false;
            fs.focus();
            if (open) { close(); } else { show(); }
        }
    }
    Rectangle {
        width: 20px;
        height: 20px;
        border-radius: 10px;
        border-width: 1.5px;
        border-color: open || touch.has-hover ? Palette.accent-background : Palette.foreground;
        background: open ? Palette.accent-background : transparent;
        Text {
            text: "i";
            font-weight: 700;
            font-size: 13px;
            color: open ? Palette.accent-foreground : Palette.foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    // Visible focus (WCAG 2.4.7), after keyboard use.
    Rectangle {
        border-width: fs.has-focus && AccessFocus.show ? 2px : 0px;
        border-color: Palette.accent-background;
        border-radius: 12px;
    }

    // Where the bubble goes. With the window size known (`AccessWindow`):
    // under the ⓘ (above it near the bottom), starting at the ⓘ when there
    // is room on the right, else ending at it, 8 px from the window edges,
    // with a pointer to the ⓘ. Without it, Slint keeps the popup inside the
    // window itself (it may then shift away from the ⓘ).
    property <length> marge: 8px;
    // At most 320 px, and never wider than the window allows.
    property <length> bw: min(weet ? AccessWindow.width - 2 * marge : 320px, min(320px, max(160px, breed.preferred-width + 24px)));
    property <length> bh: hoog.preferred-height + 24px + pijl;
    // The text measured outside the popup (Slint can't look inside it).
    breed := Text { visible: false; text: root.text; accessible-role: none; }
    hoog := Text { visible: false; width: bw - 24px; text: root.text; wrap: word-wrap; accessible-role: none; }
    property <length> pijl: 8px;
    property <bool> weet: AccessWindow.width > 0;
    property <length> ax: self.absolute-position.x;
    property <length> ay: self.absolute-position.y;
    property <length> bx: !weet ? 0
        : ax + bw + marge <= AccessWindow.width ? 0
        : ax + root.width - bw >= marge ? root.width - bw
        : marge - ax;
    property <bool> boven: weet && ay + root.height + bh + marge > AccessWindow.height && ay - bh >= marge;
    // The pointer: under the middle of the ⓘ, within the bubble's corners.
    property <length> px: max(10px, min(bw - 26px, root.width / 2 - bx - 8px));

    bubble := PopupWindow {
        x: bx;
        y: boven ? -bh - 2px : root.height + 2px;
        width: bw;
        height: bh;
        close-policy: close-on-click-outside;
        Rectangle {
            y: boven ? 0 : pijl;
            height: parent.height - pijl;
            background: Palette.background;
            border-width: 1px;
            border-color: Palette.border;
            border-radius: 6px;
            drop-shadow-blur: 8px;
            drop-shadow-color: #0004;
            // Read through the announcement and the button's description;
            // no second copy for screen readers here.
            accessible-role: none;
            VerticalLayout {
                padding: 12px;
                label := Text {
                    text: root.text;
                    wrap: word-wrap;
                    color: Palette.foreground;
                    accessible-role: none;
                }
            }
        }
        // The pointer to the ⓘ (only when we know where things are).
        Path {
            visible: weet;
            x: px;
            y: boven ? parent.height - pijl - 1px : 1px;
            width: 16px;
            height: pijl;
            viewbox-width: 16;
            viewbox-height: 8;
            commands: boven ? "M 0 0 L 8 8 L 16 0 Z" : "M 0 8 L 8 0 L 16 8 Z";
            fill: Palette.background;
            stroke: Palette.border;
            stroke-width: 1px;
            accessible-role: none;
        }
    }
    news := AccessAnnouncer { }
}
