// SPDX-License-Identifier: MIT OR Apache-2.0
//
// An accessible table for Slint, in two layers:
//
// - Building blocks: `AccessTableView` (the scroll area: only the rows that
//   fit on screen exist, however long the model is), `AccessRow` (one row:
//   focus, keys, what a screen reader hears) and `AccessTableHeader`
//   (sortable, resizable column headers, also by keyboard). Put anything you
//   like inside a row.
// - `AccessTable`: a ready-made table with text cells, a drop-in for
//   `StandardTableView` (same `columns` and `rows`).
//
// Every row takes keyboard focus itself, so assistive technology always
// knows which row is current, also after scrolling. Colours come from
// `Palette` only, so the table follows the active style (fluent, cupertino,
// material, cosmic), light and dark.

import { Palette, ScrollView } from "std-widgets.slint";
import { AccessFocus } from "focus.slint";
import { AccessMenu, AccessMenuEntry, AccessMenuItem } from "menu.slint";

// Row height: compact 24 px, standard 32 px, comfortable 40 px (as in
// IBM Carbon); rows grow when the text gets larger.
export enum AccessDensity { compact, standard, comfortable }

// How a selection changes (`AccessTable.select`); see `Selection` in the
// Rust crate. As numbers, so the Rust helper needs no generated types.
export global AccessSelect {
    out property <int> only: 0;     // just this row (click, arrows)
    out property <int> toggle: 1;   // add or remove this row (Ctrl+click, Space)
    out property <int> extend: 2;   // from the anchor to this row (Shift)
    out property <int> all: 3;      // Ctrl+A
    out property <int> clear: 4;
}

// One level of a sort: on this column, this way round.
export struct AccessSort { column: int, ascending: bool }

// Shared state between the view and its rows. Rows only read it.
export struct AccessTableState {
    // Model index of the first row slot.
    first: int,
    // Current row (keyboard focus and selection anchor), -1 = none.
    current: int,
    // Number of rows in the model.
    count: int,
    row-height: length,
    row-width: length,
    // Rows per page (PageUp/PageDown).
    page: int,
    // True while a row of this table has keyboard focus.
    active: bool,
    // Is the current row on screen (one of the slots)?
    current-visible: bool,
    // Bumped to ask the current row to take focus.
    focus-tick: int,
}

// Words of the table itself. Everything else (column titles, the name of
// the table) comes from the app, so it translates with the app.
export global AccessTableTexts {
    in-out property <string> sorted-ascending: @tr("access-widgets" => "sorted ascending");
    in-out property <string> sorted-descending: @tr("access-widgets" => "sorted descending");
    in-out property <string> column-header: @tr("access-widgets" => "column header");
    in-out property <string> items: @tr("access-widgets" => "items");
    in-out property <string> column-headers: @tr("access-widgets" => "Column headers");
    in-out property <string> no-items: @tr("access-widgets" => "No items");
    in-out property <string> loading: @tr("access-widgets" => "Loading…");
    pure public function selected-count(n: int) -> string {
        @tr("access-widgets" => "{} selected", n)
    }
    pure public function column-position(n: int, of: int) -> string {
        @tr("access-widgets" => "column {} of {}", n, of)
    }
    pure public function sort-level(n: int) -> string {
        @tr("access-widgets" => "level {}", n)
    }
    in-out property <string> then: @tr("access-widgets" => "then");
    // The column header menu.
    in-out property <string> sort-ascending-command: @tr("access-widgets" => "Sort ascending");
    in-out property <string> sort-descending-command: @tr("access-widgets" => "Sort descending");
    in-out property <string> add-to-sort: @tr("access-widgets" => "Add to sort");
    in-out property <string> size-to-fit: @tr("access-widgets" => "Size to fit");
    in-out property <string> hide-column: @tr("access-widgets" => "Hide column");
    in-out property <string> columns-menu: @tr("access-widgets" => "Columns");
    in-out property <string> move-left: @tr("access-widgets" => "Move left");
    in-out property <string> move-right: @tr("access-widgets" => "Move right");
    in-out property <string> column-menu: @tr("access-widgets" => "column menu");
    in-out property <string> column-hidden: @tr("access-widgets" => "hidden");
    in-out property <string> column-shown: @tr("access-widgets" => "shown");
    pure public function copied-count(n: int) -> string {
        @tr("access-widgets" => "{n} row copied" | "{n} rows copied" % n)
    }
    pure public function shown-of(shown: int, total: int) -> string {
        @tr("access-widgets" => "{} of {} shown", shown, total)
    }
}

// The scroll area. Put `for k in view.slots : AccessRow { index: view.first + k; … }`
// inside; see `AccessTable` below for a full example.
export component AccessTableView inherits ScrollView {
    // What a screen reader calls this table, e.g. "Downloads".
    in property <string> label;
    in property <int> count;
    // Taller rows when the text gets larger (WCAG 1.4.4); at least 24 px
    // (WCAG 2.5.8 target size).
    in property <AccessDensity> density: standard;
    // Taller when the text gets larger (WCAG 1.4.4); never under 24 px
    // (WCAG 2.5.8 target size).
    in property <length> row-height: density == AccessDensity.compact ? max(24px, measure.preferred-height + 6px)
        : density == AccessDensity.comfortable ? max(40px, measure.preferred-height + 18px)
        : max(32px, measure.preferred-height + 12px);
    in-out property <int> current: count > 0 ? 0 : -1;
    // Number of row slots: only these exist.
    out property <int> slots: min(count, ceil(self.visible-height / row-height) + 1);
    out property <int> first: max(0, min(count - slots, floor(-self.content-y / row-height)));
    out property <AccessTableState> state: {
        first: first,
        current: current,
        count: count,
        row-height: row-height,
        row-width: max(self.visible-width, content-min-width),
        page: max(1, floor(self.visible-height / row-height) - 1),
        active: active,
        current-visible: current >= first && current < first + slots,
        focus-tick: focus-tick,
    };
    // Set by rows; see `AccessRow.focus-changed`.
    in-out property <bool> active;
    property <int> focus-tick;
    // Extra space at the top that is covered (a sticky header): a focused
    // row is never hidden under it (WCAG 2.4.11).
    in property <length> covered-top: 0;
    // Rows are at least this wide; when the view is narrower, it scrolls
    // sideways (`AccessTableHeader.needed-width`).
    in property <length> content-min-width: 0;
    // Width kept in place on the left while scrolling sideways (a frozen
    // first column): cells are scrolled into view right of it.
    in property <length> covered-left: 0;

    // Bring the stretch `x .. x + w` of a row into view sideways.
    public function reveal-x(x: length, w: length) {
        if (x + self.content-x < covered-left && x > 0) {
            self.content-x = min(0, -(x - covered-left));
        }
        if (x + w + self.content-x > self.visible-width) {
            self.content-x = -(x + w - self.visible-width);
        }
        if (x == 0) { self.content-x = 0; }
    }

    callback current-changed(int);

    // Lazy loading: the rows on screen (from `first`, `count` rows), so the
    // app can fetch just those, e.g. from a server or another computer.
    // Called when the view scrolls or resizes; may repeat a range, see
    // `slint_access_widgets::LazyRows` to skip what is loaded already.
    callback rows-needed(first: int, count: int);
    property <int> needed-first: first;
    property <int> needed-count: slots;
    changed needed-first => { rows-needed(first, slots); }
    changed needed-count => { rows-needed(first, slots); }
    init => { rows-needed(first, slots); }

    // Type-ahead: return the first row at or after `from` whose text starts
    // with `prefix` (case-insensitive), as index + 1; 0 = none. Without a
    // handler, type-ahead does nothing. `slint_access_widgets::find_prefix`
    // does it for a `StandardListViewItem` model.
    callback find(prefix: string, from: int) -> int;
    property <string> typed;

    // Move to row `i`, bring it into view and give it focus.
    public function go-to(i: int) {
        if (count == 0) { return; }
        current = max(0, min(count - 1, i));
        bring-into-view(current);
        focus-tick += 1;
        current-changed(current);
    }

    // Make row `i` current without taking the focus, e.g. to keep it on the
    // same item after sorting while the focus is on a column header.
    public function move-current(i: int) {
        if (count == 0) { return; }
        current = max(0, min(count - 1, i));
        bring-into-view(current);
    }

    // Give keyboard focus to the current row (e.g. after Tab into the table).
    public function focus-current() {
        if (current < 0 && count > 0) { current = 0; }
        bring-into-view(current);
        focus-tick += 1;
    }

    public function bring-into-view(i: int) {
        if (i * row-height + self.content-y < covered-top) {
            self.content-y = -(i * row-height) + covered-top;
        }
        if ((i + 1) * row-height + self.content-y > self.visible-height) {
            self.content-y = -((i + 1) * row-height - self.visible-height);
        }
    }

    // A typed character: search on, restart after a second of quiet. The
    // same letter again and again walks through the rows with that letter
    // (as in File Explorer and Finder); different letters search for the
    // whole word.
    property <bool> cycling;
    public function type-ahead(text: string) {
        let t = text.to-lowercase();
        if (typed == "") {
            typed = t;
            cycling = true;
        } else if (cycling && t == typed) {
            // Keep the single letter: next match.
        } else {
            typed += t;
            cycling = false;
        }
        if (quiet.running) { quiet.restart(); } else { quiet.start(); }
        let from = cycling ? current + 1 : current;
        let hit = find(typed, from);
        if (hit > 0) {
            go-to(hit - 1);
        } else if (from > 0) {
            let wrap = find(typed, 0);
            if (wrap > 0) { go-to(wrap - 1); }
        }
    }

    quiet := Timer {
        interval: 1s;
        running: false;
        triggered => {
            typed = "";
            self.stop();
        }
    }

    accessible-role: table;
    accessible-label: label;
    accessible-description: count + " " + AccessTableTexts.items;
    content-height: count * row-height;
    content-width: max(self.visible-width, content-min-width);

    measure := Text {
        text: "Mg";
        visible: false;
        accessible-role: none;
    }

    @children
}

// One row. Inside: whatever you want (text, check boxes, combo boxes). Keep
// all state in your model, not in the widgets: rows are reused while
// scrolling.
export component AccessRow inherits Rectangle {
    in property <AccessTableState> state;
    in property <int> index;
    // What a screen reader says for this row, e.g. "report.pdf, Size 2 MB".
    in property <string> label;
    in property <bool> selected: index == state.current;

    // Move to a row. The modifiers say how the selection follows (Shift
    // extends, Ctrl only moves the focus).
    callback navigate(int, KeyboardModifiers);
    // Ctrl+A.
    callback select-all();
    // Ctrl+C.
    callback copy();
    // Enter or double click.
    callback activated(int);
    // Left/Right arrows (-1/+1), for cell navigation.
    callback horizontal(int);
    // A printable character, for type-ahead.
    callback typed(string);
    // Space.
    callback toggled(int);
    // Delete: e.g. remove, or cancel a transfer.
    callback deleted(int);
    // Menu key or Shift+F10, or a right click: open your context menu.
    callback context-menu(int, length, length);
    callback focus-changed(bool);

    out property <bool> has-keyboard-focus: fs.has-focus;
    // Where the mouse is over this row (for tooltips on cells).
    out property <bool> hovering: touch.has-hover;
    out property <length> hover-x: touch.mouse-x;
    // Escape on this row (e.g. to close a tooltip); accepted when it did.
    callback escape() -> bool;
    property <bool> is-current: index == state.current;

    visible: index < state.count;
    y: index * state.row-height;
    width: state.row-width;
    height: state.row-height;
    // A colour for this row's state, e.g. `AccessColors.success-background`
    // when it is done. Selection and hover go first, so you always see
    // where you are.
    in property <brush> background-tint: transparent;
    // Selected rows all get the selection colour while the table has the
    // focus; the focused one is told apart by its border.
    background: selected ? (state.active ? Palette.selection-background : Palette.alternate-background) : (touch.has-hover ? Palette.alternate-background : background-tint);
    // Text colour to use on this row (contrast on the selection colour).
    out property <brush> text-color: selected && state.active ? Palette.selection-foreground : Palette.foreground;

    accessible-role: list-item;
    accessible-label: label;
    accessible-item-selectable: true;
    accessible-item-selected: selected;
    accessible-item-index: index;
    accessible-item-count: state.count;
    accessible-action-default => { activated(index); }

    function claim() {
        if (is-current && state.active && !fs.has-focus) { fs.focus(); }
    }
    function claim-always() {
        if (is-current && !fs.has-focus) { fs.focus(); }
    }

    // Only take focus while the table already has it: scrolling with the
    // mouse wheel must not steal focus from elsewhere.
    changed index => { claim(); }
    // When the table gets shorter or taller (the window or a neighbour
    // changes size), Slint makes the row slots anew, also the one that had
    // the focus. The new slot of the current row takes it back.
    init => { claim(); }
    changed is-current => { claim(); }
    // An explicit request (go-to, focus-current) always wins.
    property <int> tick: state.focus-tick;
    changed tick => { claim-always(); }

    touch := TouchArea {
        double-clicked => { activated(index); }
        pointer-event(e) => {
            if (e.kind != PointerEventKind.down) { return; }
            AccessFocus.keyboard = false;
            if (e.button == PointerEventButton.left) {
                navigate(index, e.modifiers);
                // Ctrl+click adds or removes this row (as in File Explorer).
                if (e.modifiers.control && !e.modifiers.shift) { toggled(index); }
                fs.focus();
            } else if (e.button == PointerEventButton.right) {
                // Right click on a row outside the selection selects it.
                if (!selected) { navigate(index, e.modifiers); }
                fs.focus();
                context-menu(index, self.mouse-x, self.mouse-y);
            }
        }
    }

    fs := FocusScope {
        // One Tab stop for the whole table: only the current row (or, when
        // that is scrolled away, the first row on screen, which hands the
        // focus on to the current row).
        focus-on-tab-navigation: is-current || (!state.current-visible && index == state.first);
        // Clicks go to the TouchArea below (it selects, then focuses).
        focus-on-click: false;
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) { AccessFocus.keyboard = true; }
            if (!is-current) { navigate(state.current, { control: true }); }
        }
        focus-changed-event => { focus-changed(self.has-focus); }
        capture-key-pressed(e) => {
            AccessFocus.keyboard = true;
            reject
        }
        key-pressed(e) => {
            if (e.text == Key.DownArrow) { navigate(index + 1, e.modifiers); return accept; }
            if (e.text == Key.UpArrow) { navigate(index - 1, e.modifiers); return accept; }
            if (e.text == Key.PageDown) { navigate(index + state.page, e.modifiers); return accept; }
            if (e.text == Key.PageUp) { navigate(index - state.page, e.modifiers); return accept; }
            if (e.text == Key.Home) { navigate(0, e.modifiers); return accept; }
            if (e.text == Key.End) { navigate(state.count - 1, e.modifiers); return accept; }
            if (e.modifiers.control && (e.text == "a" || e.text == "A")) { select-all(); return accept; }
            if (e.modifiers.control && (e.text == "c" || e.text == "C")) { copy(); return accept; }
            if (e.text == Key.LeftArrow) { horizontal(-1); return accept; }
            if (e.text == Key.RightArrow) { horizontal(1); return accept; }
            if (e.text == Key.Return) { activated(index); return accept; }
            if (e.text == " ") { toggled(index); return accept; }
            if (e.text == Key.Delete) { deleted(index); return accept; }
            if (e.text == Key.Escape && escape()) { return accept; }
            if (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift)) {
                context-menu(index, 16px, root.height);
                return accept;
            }
            // Letters and digits: type-ahead. (Special keys are single
            // private-use characters, so test for "is a letter or digit".)
            if (!e.modifiers.control && !e.modifiers.alt && !e.modifiers.meta && e.text.character-count == 1
                && (e.text.to-uppercase() != e.text.to-lowercase() || e.text.is-float())) {
                typed(e.text);
                return accept;
            }
            reject
        }
    }

    @children

    // Visible focus (WCAG 2.4.7): 2 px, just inside the row, drawn on top;
    // after a mouse click only the selection shows (see `AccessFocus`). On
    // a selected row in the selection colour, so it never vanishes into it.
    Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-width: fs.has-focus && AccessFocus.show ? 2px : 0px;
        border-color: selected && state.active ? Palette.selection-foreground : Palette.accent-background;
        border-radius: 2px;
    }
}

// One header cell (inside `AccessTableHeader`).
component HeaderCell inherits Rectangle {
    in property <TableColumn> column;
    in property <string> arrow;
    in property <bool> focused;
    in property <int> resize-tick;
    in property <bool> resize-me;
    in property <length> resize-delta;
    // A click; true with Shift held (add a sort level).
    callback clicked(bool);
    // Right click on this cell, at `x` from its left.
    callback context(length);
    callback set-width(length);
    // Double click on the edge: fit the column to its contents.
    callback fit();
    // Focused by keyboard: scroll me into view.
    callback reveal(length, length);
    changed focused => { if (focused) { reveal(self.x, self.width); } }
    // The width the title needs (for fitting).
    out property <length> title-width: title.preferred-width + 34px;

    // A column with a negative width is hidden (see the header menu).
    visible: column.width >= 0;
    min-width: column.width < 0 ? 0 : column.width >= 1px ? column.width : max(column.min-width, 32px);
    max-width: column.width < 0 ? 0 : column.width >= 1px ? column.width : 100000px;
    horizontal-stretch: column.width < 0 ? 0 : column.width >= 1px ? 0 : max(column.horizontal-stretch, 0.0001);

    function apply(delta: length) {
        set-width(max(max(column.min-width, 32px), (column.width >= 1px ? column.width : root.width) + delta));
    }
    changed resize-tick => { if (resize-me) { apply(resize-delta); } }

    title := Text {
        x: 8px;
        width: parent.width - 32px;
        text: column.title;
        font-weight: 600;
        color: Palette.foreground;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    Text {
        x: parent.width - 24px;
        text: arrow;
        color: Palette.foreground;
        vertical-alignment: center;
        accessible-role: none;
    }
    TouchArea {
        property <bool> shift;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                self.shift = e.modifiers.shift;
                if (e.button == PointerEventButton.right) { context(self.mouse-x); }
            }
        }
        clicked => { root.clicked(self.shift); }
    }
    // Drag the right edge to resize (keyboard: Ctrl+Left/Right).
    TouchArea {
        x: parent.width - 4px;
        width: 8px;
        mouse-cursor: col-resize;
        property <length> start;
        double-clicked => { fit(); }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) { self.start = self.mouse-x; }
        }
        moved => {
            if (self.pressed) { apply(self.mouse-x - self.start); }
        }
    }
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        background: Palette.border;
    }
    // Visible focus (WCAG 2.4.7).
    Rectangle {
        border-width: focused ? 2px : 0px;
        border-color: Palette.accent-background;
        border-radius: 2px;
    }
}

// Column headers: one Tab stop. Left/Right picks a column, Enter or Space
// sorts, Ctrl+Left/Right makes it narrower or wider (also by mouse: drag the
// edge; WCAG 2.5.7 asks for the keyboard way too). Widths are written back
// into `columns[i].width`, so rows below can follow.
export component AccessTableHeader inherits Rectangle {
    in-out property <[TableColumn]> columns;
    in-out property <int> current-column: 0;
    // The column the table is sorted on, -1 = none; with Shift+click or
    // Shift+Enter a second and third level (-1 = none).
    in-out property <int> sort-column: -1;
    in-out property <int> sort-column2: -1;
    in-out property <int> sort-column3: -1;
    // The whole sort, every time it changes: first level first. Sort your
    // rows like that (`a.cmp(b).then_with(…)`). Single-level sorts also
    // call `sort-ascending`/`sort-descending`.
    callback sort-changed([AccessSort]);
    // "Move left/right" in the header menu: put column `from` at `to`. Only
    // your app can reorder the cells of the rows too, so it does the move
    // (reorder `columns` and every row the same way).
    callback move-column(from: int, to: int);
    // False: the headers are just labels (no sorting, no "sorted" words).
    in property <bool> sortable: true;
    callback sort-ascending(int);
    callback sort-descending(int);
    // Fit column `i` to its contents; `title-width` is what its title needs.
    // `AccessTable` measures the cells on screen and sets the width.
    callback fit-column(i: int, title-width: length);
    // A header cell got the keyboard focus at `x .. x + w`: scroll there.
    callback reveal-x(x: length, w: length);
    out property <bool> has-keyboard-focus: fs.has-focus;
    // A fit asked by keyboard goes through a tick: only the cell knows its
    // title width.
    property <int> fit-tick;
    property <int> fit-me: -1;
    public function request-fit(i: int) {
        fit-me = i;
        fit-tick += 1;
    }
    // The width all columns need at least (their minimum widths): when the
    // table is narrower, it scrolls sideways.
    out property <length> needed-width: widths.min-width;
    // The width of the first column when the table scrolls sideways (all
    // columns at their minimum then), for keeping it in place.
    out property <length> first-width: columns.length == 0 || columns[0].width < 0 ? 0 : columns[0].width >= 1px ? columns[0].width : max(columns[0].min-width, 32px);

    // Measures `needed-width` (never shown).
    widths := HorizontalLayout {
        visible: false;
        for col in columns : Rectangle {
            min-width: col.width < 0 ? 0 : col.width >= 1px ? col.width : max(col.min-width, 32px);
        }
    }

    // Keyboard resize goes through a tick: only the cell knows its width.
    property <int> resize-column: -1;
    property <length> resize-delta;
    property <int> resize-tick;

    height: max(32px, measure.preferred-height + 12px);
    background: Palette.alternate-background;

    // For assistive technology the focus is on the button of the current
    // column, not on this bar.
    accessible-role: groupbox;
    accessible-label: AccessTableTexts.column-headers;
    accessible-delegate-focus: current-column;

    measure := Text {
        text: "Mg";
        visible: false;
        accessible-role: none;
    }

    // Sort on column `i` (as a click on its header).
    public function sort-by(i: int) {
        current-column = i;
        sort(i);
    }

    function sort(i: int) {
        if (!sortable) { return; }
        let ascending = !(i == sort-column && sort-column2 < 0 && columns[i].sort-order == SortOrder.ascending);
        sort-column = i;
        sort-column2 = -1;
        sort-column3 = -1;
        columns[i].sort-order = ascending ? SortOrder.ascending : SortOrder.descending;
        if (ascending) { sort-ascending(i); } else { sort-descending(i); }
        sort-changed(levels());
    }

    // Shift: add column `i` as the next level, or turn it round when it is
    // in the sort already. Three levels at most (a fourth replaces the third).
    function add-sort(i: int) {
        if (!sortable) { return; }
        if (i == sort-column || i == sort-column2 || i == sort-column3) {
            columns[i].sort-order = columns[i].sort-order == SortOrder.ascending ? SortOrder.descending : SortOrder.ascending;
        } else {
            columns[i].sort-order = SortOrder.ascending;
            if (sort-column < 0) { sort-column = i; }
            else if (sort-column2 < 0) { sort-column2 = i; }
            else { sort-column3 = i; }
        }
        if (sort-column2 < 0) {
            if (columns[i].sort-order == SortOrder.ascending) { sort-ascending(i); } else { sort-descending(i); }
        }
        sort-changed(levels());
    }

    pure function level(c: int) -> AccessSort {
        { column: c, ascending: columns[c].sort-order != SortOrder.descending }
    }
    pure public function levels() -> [AccessSort] {
        sort-column < 0 ? [] : sort-column2 < 0 ? [level(sort-column)]
            : sort-column3 < 0 ? [level(sort-column), level(sort-column2)]
            : [level(sort-column), level(sort-column2), level(sort-column3)]
    }
    // 1, 2, 3 or 0 (not in the sort).
    pure public function level-of(i: int) -> int {
        i == sort-column ? 1 : i == sort-column2 ? 2 : i == sort-column3 ? 3 : 0
    }
    // ▲ or ▼, with the level when there is more than one.
    pure public function arrow-for(i: int) -> string {
        level-of(i) == 0 ? ""
            : (columns[i].sort-order == SortOrder.descending ? "▼" : "▲") + (sort-column2 >= 0 ? level-of(i) : "")
    }

    // Sort on one column, this way round (from the menu).
    function set-sort(i: int, ascending: bool) {
        if (!sortable) { return; }
        sort-column = i;
        sort-column2 = -1;
        sort-column3 = -1;
        columns[i].sort-order = ascending ? SortOrder.ascending : SortOrder.descending;
        if (ascending) { sort-ascending(i); } else { sort-descending(i); }
        sort-changed(levels());
    }

    // Hide or show column `i` (a negative width hides; showing gives it its
    // natural width again). The last visible column cannot be hidden.
    // How many columns are shown (up to 24 counted; Slint has no loops).
    out property <int> shown-count: (columns.length > 0 && columns[0].width >= 0 ? 1 : 0) + (columns.length > 1 && columns[1].width >= 0 ? 1 : 0) + (columns.length > 2 && columns[2].width >= 0 ? 1 : 0) + (columns.length > 3 && columns[3].width >= 0 ? 1 : 0) + (columns.length > 4 && columns[4].width >= 0 ? 1 : 0) + (columns.length > 5 && columns[5].width >= 0 ? 1 : 0) + (columns.length > 6 && columns[6].width >= 0 ? 1 : 0) + (columns.length > 7 && columns[7].width >= 0 ? 1 : 0) + (columns.length > 8 && columns[8].width >= 0 ? 1 : 0) + (columns.length > 9 && columns[9].width >= 0 ? 1 : 0) + (columns.length > 10 && columns[10].width >= 0 ? 1 : 0) + (columns.length > 11 && columns[11].width >= 0 ? 1 : 0) + (columns.length > 12 && columns[12].width >= 0 ? 1 : 0) + (columns.length > 13 && columns[13].width >= 0 ? 1 : 0) + (columns.length > 14 && columns[14].width >= 0 ? 1 : 0) + (columns.length > 15 && columns[15].width >= 0 ? 1 : 0) + (columns.length > 16 && columns[16].width >= 0 ? 1 : 0) + (columns.length > 17 && columns[17].width >= 0 ? 1 : 0) + (columns.length > 18 && columns[18].width >= 0 ? 1 : 0) + (columns.length > 19 && columns[19].width >= 0 ? 1 : 0) + (columns.length > 20 && columns[20].width >= 0 ? 1 : 0) + (columns.length > 21 && columns[21].width >= 0 ? 1 : 0) + (columns.length > 22 && columns[22].width >= 0 ? 1 : 0) + (columns.length > 23 && columns[23].width >= 0 ? 1 : 0);
    // Shown or hidden: for an announcement.
    callback column-toggled(column: int, shown: bool);
    public function toggle-column(i: int) {
        if (columns[i].width < 0) {
            columns[i].width = 0;
            column-toggled(i, true);
        } else if (shown-count > 1) {
            columns[i].width = -1px;
            if (current-column == i) { current-column = next-shown(i, i < columns.length - 1 ? 1 : -1); }
            column-toggled(i, false);
        }
    }

    // The next shown column from `i` in direction `d` (hidden ones are
    // skipped; up to four in a row).
    pure function shown(i: int) -> bool { i >= 0 && i < columns.length && columns[i].width >= 0 }
    pure public function next-shown(i: int, d: int) -> int {
        shown(i + d) ? i + d : shown(i + 2 * d) ? i + 2 * d : shown(i + 3 * d) ? i + 3 * d
            : shown(i + 4 * d) ? i + 4 * d : shown(i + 5 * d) ? i + 5 * d : i
    }

    // Swap two neighbouring columns: the sort marks and the focus go along;
    // the app moves the data (`move-column`).
    function do-move(from: int, to: int) {
        if (sort-column == from) { sort-column = to; } else if (sort-column == to) { sort-column = from; }
        if (sort-column2 == from) { sort-column2 = to; } else if (sort-column2 == to) { sort-column2 = from; }
        if (sort-column3 == from) { sort-column3 = to; } else if (sort-column3 == to) { sort-column3 = from; }
        current-column = to;
        move-column(from, to);
    }

    // The column menu (right click, Menu key or Shift+F10): `AccessTable`
    // shows it (an `AccessMenu`-style list that screen readers can follow).
    // `x` is where, from the left of this header.
    callback menu-requested(column: int, x: length);
    property <length> menu-x;
    public function show-menu(i: int) {
        menu-requested(i, menu-x);
    }
    // Give the focus back (after the menu closes).
    public function focus-header() { fs.focus(); }
    // An item of the column menu was chosen (see `ColumnMenu`).
    public function menu-action(c: int, item: int) {
        if (item == 0) { set-sort(c, true); }
        else if (item == 1) { set-sort(c, false); }
        else if (item == 2) { add-sort(c); }
        else if (item == 3) { request-fit(c); }
        else if (item == 4) { toggle-column(c); }
        else if (item == 5 && c > 0) { do-move(c, c - 1); }
        else if (item == 6 && c < columns.length - 1) { do-move(c, c + 1); }
        else if (item >= 7) { toggle-column(item - 7); }
    }

    function resize(i: int, delta: length) {
        resize-column = i;
        resize-delta = delta;
        resize-tick += 1;
    }

    pure function sort-text(i: int) -> string {
        level-of(i) == 0 ? ""
            : (columns[i].sort-order == SortOrder.descending ? ", " + AccessTableTexts.sorted-descending : ", " + AccessTableTexts.sorted-ascending)
                + (sort-column2 >= 0 ? ", " + AccessTableTexts.sort-level(level-of(i)) : "")
    }

    fs := FocusScope {
        focus-on-tab-navigation: sortable;
        focus-gained(reason) => {
            if (reason == FocusReason.tab-navigation) { AccessFocus.keyboard = true; }
        }
        capture-key-pressed(e) => {
            AccessFocus.keyboard = true;
            reject
        }
        key-pressed(e) => {
            if (e.text == Key.LeftArrow && e.modifiers.control && e.modifiers.shift && current-column > 0) { do-move(current-column, current-column - 1); return accept; }
            if (e.text == Key.RightArrow && e.modifiers.control && e.modifiers.shift && current-column < columns.length - 1) { do-move(current-column, current-column + 1); return accept; }
            if (e.text == Key.LeftArrow && e.modifiers.control && !e.modifiers.shift) { resize(current-column, -16px); return accept; }
            if (e.text == Key.RightArrow && e.modifiers.control && !e.modifiers.shift) { resize(current-column, 16px); return accept; }
            if (e.text == Key.LeftArrow) { current-column = next-shown(current-column, -1); return accept; }
            if (e.text == Key.RightArrow) { current-column = next-shown(current-column, 1); return accept; }
            if (e.text == Key.Home) { current-column = shown(0) ? 0 : next-shown(0, 1); return accept; }
            if (e.text == Key.End) { current-column = shown(columns.length - 1) ? columns.length - 1 : next-shown(columns.length - 1, -1); return accept; }
            // The menu: Menu key or Shift+F10.
            if (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift)) { show-menu(current-column); return accept; }
            // Everything in the menu has a key too: Ctrl+Shift+Left/Right
            // moves the column, Delete hides it.
            if (e.text == Key.Delete) { toggle-column(current-column); return accept; }
            if ((e.text == Key.Return || e.text == " ") && e.modifiers.shift) { add-sort(current-column); return accept; }
            if (e.text == Key.Return || e.text == " ") { sort(current-column); return accept; }
            // Ctrl and + : fit the column to its contents (as in File Explorer).
            if (e.modifiers.control && (e.text == "+" || e.text == "=")) { request-fit(current-column); return accept; }
            reject
        }
    }

    // Sortable: buttons. Not sortable: plain labels, and no Tab stop.
    if sortable : HorizontalLayout {
        for col[i] in columns : HeaderCell {
            accessible-role: button;
            accessible-label: col.title + sort-text(i);
            accessible-description: AccessTableTexts.column-header;
            accessible-item-index: i;
            accessible-item-count: columns.length;
            accessible-action-default => { sort(i); }
            column: col;
            arrow: arrow-for(i);
            focused: fs.has-focus && i == current-column && AccessFocus.show;
            resize-tick: resize-tick;
            resize-me: resize-column == i;
            resize-delta: resize-delta;
            clicked(shift) => {
                AccessFocus.keyboard = false;
                current-column = i;
                fs.focus();
                if (shift) { add-sort(i); } else { sort(i); }
            }
            set-width(w) => { columns[i].width = w; }
            fit => { request-fit(i); }
            reveal(x, w) => {
                reveal-x(x, w);
                menu-x = x;
            }
            context(x) => {
                AccessFocus.keyboard = false;
                current-column = i;
                fs.focus();
                menu-requested(i, self.x + x);
            }

            property <int> fit-ticks: fit-tick;
            changed fit-ticks => { if (fit-me == i) { fit-column(i, self.title-width); } }
        }
    }
    if !sortable : HorizontalLayout {
        for col[i] in columns : HeaderCell {
            accessible-role: text;
            accessible-label: col.title;
            column: col;
            set-width(w) => { columns[i].width = w; }
            fit => { request-fit(i); }
            property <int> fit-ticks: fit-tick;
            changed fit-ticks => { if (fit-me == i) { fit-column(i, self.title-width); } }
        }
    }
}


// The column menu of `AccessTable`: the actions for one column, then all
// columns with a tick to show or hide them. Items are the same as in
// `AccessMenu` (focus per item, so screen readers follow).
component ColumnMenu inherits Rectangle {
    in property <[TableColumn]> columns;
    in property <int> column;
    in property <bool> sortable;
    in property <bool> can-add-sort;
    in property <bool> can-hide;
    in property <string> label;
    // 0 sort ascending, 1 sort descending, 2 add to sort, 3 size to fit,
    // 4 hide, 5 move left, 6 move right, 7 + i: show or hide column i.
    callback activated(int);
    callback closed();

    property <bool> shown;
    property <int> current;
    property <int> focus-tick;
    property <length> at-x;
    property <length> at-y;
    property <int> count: 7 + columns.length;

    public function open(x: length, y: length) {
        at-x = x;
        at-y = y;
        current = first-ok(0, 1);
        shown = true;
        focus-tick += 1;
    }
    public function close() {
        if (!shown) { return; }
        shown = false;
        closed();
    }

    pure function enabled-at(i: int) -> bool {
        i < 0 || i >= count ? false
            : i <= 1 ? sortable
            : i == 2 ? sortable && can-add-sort
            : i == 4 ? can-hide
            : i == 5 ? column > 0
            : i == 6 ? column < columns.length - 1
            : true
    }
    pure function title-at(i: int) -> string {
        i == 0 ? AccessTableTexts.sort-ascending-command : i == 1 ? AccessTableTexts.sort-descending-command
            : i == 2 ? AccessTableTexts.add-to-sort : i == 3 ? AccessTableTexts.size-to-fit
            : i == 4 ? AccessTableTexts.hide-column : i == 5 ? AccessTableTexts.move-left
            : i == 6 ? AccessTableTexts.move-right : i - 7 < columns.length ? columns[i - 7].title : ""
    }
    pure function first-ok(i: int, d: int) -> int {
        enabled-at(i) ? i : enabled-at(i + d) ? i + d : enabled-at(i + 2 * d) ? i + 2 * d
            : enabled-at(i + 3 * d) ? i + 3 * d : enabled-at(i + 4 * d) ? i + 4 * d : current
    }
    function move(d: int) {
        if (d <= -1000) { current = first-ok(0, 1); }
        else if (d >= 1000) { current = first-ok(count - 1, -1); }
        else {
            let next = first-ok(current + d, d);
            current = next != current ? next : d > 0 ? first-ok(0, 1) : first-ok(count - 1, -1);
        }
        focus-tick += 1;
    }
    pure function starts(i: int, l: string) -> bool { enabled-at(i) && title-at(i).to-lowercase().starts-with(l) }
    function jump(l: string) {
        let a = mod(current + 1, count);
        let b = mod(current + 2, count);
        let c = mod(current + 3, count);
        let d = mod(current + 4, count);
        let e = mod(current + 5, count);
        let f = mod(current + 6, count);
        let g = mod(current + 7, count);
        let h = mod(current + 8, count);
        current = starts(a, l) ? a : starts(b, l) ? b : starts(c, l) ? c : starts(d, l) ? d
            : starts(e, l) ? e : starts(f, l) ? f : starts(g, l) ? g : starts(h, l) ? h : current;
        focus-tick += 1;
    }

    visible: shown;
    TouchArea {
        enabled: shown;
        clicked => { close(); }
    }
    box := Rectangle {
        x: max(0, min(at-x, root.width - self.width - 2px));
        y: at-y + self.height > root.height ? max(0, at-y - self.height) : at-y;
        width: max(220px, list.preferred-width);
        height: min(list.preferred-height, root.height);
        background: Palette.background;
        border-width: 1px;
        border-color: Palette.border;
        border-radius: 4px;
        drop-shadow-blur: 8px;
        drop-shadow-color: #0005;
        clip: true;
        accessible-role: AccessibleRole.list;
        accessible-label: label;
        accessible-item-count: count;

        list := VerticalLayout {
            padding: 4px;
            for i in 7 : AccessMenuEntry {
                item: { title: title-at(i), enabled: enabled-at(i), separator: i == 3 || i == 5 };
                index: i;
                count: count;
                current: i == current;
                focus-tick: focus-tick;
                chosen => { close(); activated(i); }
                move(d) => { root.move(d); }
                jump(l) => { root.jump(l); }
                close => { root.close(); }
                hovered => { if (enabled-at(i)) { current = i; focus-tick += 1; } }
            }
            for col[c] in columns : AccessMenuEntry {
                item: { title: col.title, enabled: true, checkable: true, checked: col.width >= 0, separator: c == 0 };
                index: 7 + c;
                count: count;
                current: 7 + c == current;
                focus-tick: focus-tick;
                chosen => { close(); activated(7 + c); }
                move(d) => { root.move(d); }
                jump(l) => { root.jump(l); }
                close => { root.close(); }
                hovered => { current = 7 + c; focus-tick += 1; }
            }
        }
    }
}

// A ready-made table with text cells: a drop-in for `StandardTableView`
// (same `columns`, `rows`, `current-row`, sort callbacks), but accessible:
// a screen reader hears every row as "report.pdf, Size 2 MB, Modified
// yesterday" (the first column bare, the others with their title, up to 24
// columns), also far down the list, and Left/Right reads one cell at a
// time. The header stays in place while the rows scroll.
export component AccessTable inherits Rectangle {
    // What a screen reader calls this table, e.g. "Downloads".
    in property <string> label;
    in-out property <[TableColumn]> columns;
    in property <[[StandardListViewItem]]> rows;
    in-out property <int> current-row <=> view.current;
    in-out property <int> current-column: 0;
    in-out property <int> sort-column <=> header.sort-column;
    in property <AccessDensity> density: standard;
    // Several rows at once (Ctrl/Shift, Space, Ctrl+A). Give `selected-rows`
    // and handle `select` with `slint_access_widgets::Selection`.
    in property <bool> multi-select: false;
    in property <[bool]> selected-rows;
    // Returns how many rows are selected now.
    callback select(row: int, how: int) -> int;
    // While true: "Loading…" instead of the rows.
    in property <bool> loading: false;
    // Shown (and read) when there are no rows.
    in property <string> empty-text: AccessTableTexts.no-items;
    callback sort-ascending(int);
    callback sort-descending(int);
    // The whole sort (Shift+click or Shift+Enter adds levels), first level
    // first. Handle this or the two above, not both.
    callback sort-changed([AccessSort]);
    // "Move left/right" in the header menu: swap column `from` with `to`,
    // in `columns` and in every row (only your app can do that).
    callback move-column(from: int, to: int);
    callback current-row-changed(int);
    // Enter or double click on a row.
    callback row-activated(int);
    // Menu key, Shift+F10 or right click.
    callback row-context-menu(int, length, length);
    // A menu on the rows (right click, Menu key or Shift+F10), one that
    // screen readers follow (`AccessMenu`). Empty: no menu, only
    // `row-context-menu` (for a menu of your own).
    in property <[AccessMenuItem]> row-menu;
    // An item of `row-menu` was chosen for this row; afterwards the focus
    // is back on the row.
    callback row-menu-activated(row: int, item: int);
    // Type-ahead on the first column: wire it to
    // `slint_access_widgets::find_prefix` (see the crate docs).
    callback find(prefix: string, from: int) -> int;
    // Lazy loading: these rows are on screen. A row that is not loaded yet
    // is an empty array in `rows`: it shows and reads "Loading…". See
    // `slint_access_widgets::LazyRows`.
    callback rows-needed(first: int, count: int);
    // Ctrl+C: copy the selected rows (or the current one). Return how many
    // rows were copied; it is announced. `slint_access_widgets::copy_rows`
    // does it (with the `clipboard` feature).
    callback copy(current-row: int) -> int;
    // When the columns don't fit and the table scrolls sideways, the first
    // column (usually the name) stays in place.
    in property <bool> freeze-first-column: true;
    property <bool> frozen: freeze-first-column && columns.length > 1;

    public function focus-current() { view.focus-current(); }
    public function set-current-row(i: int) { view.go-to(i); }
    // Without taking the focus: after sorting, keep the current row on its
    // item (`Selection::index_of`).
    public function keep-current-row(i: int) { view.move-current(i); }

    min-width: 200px;
    min-height: 120px;
    background: Palette.background;
    border-width: 1px;
    border-color: Palette.border;

    // A status message (WCAG 4.1.3). Saying the same thing twice must be
    // heard twice, so alternate an invisible space at the end.
    property <bool> flip;
    function announce(t: string) {
        flip = !flip;
        cell-news.text = t + (flip ? "" : " ");
    }

    pure function level-words(l: AccessSort) -> string {
        columns[l.column].title + ", " + (l.ascending ? AccessTableTexts.sorted-ascending : AccessTableTexts.sorted-descending)
    }
    pure function sort-words(l: [AccessSort]) -> string {
        (l.length > 0 ? level-words(l[0]) : "")
            + (l.length > 1 ? ", " + AccessTableTexts.then + " " + level-words(l[1]) : "")
            + (l.length > 2 ? ", " + AccessTableTexts.then + " " + level-words(l[2]) : "")
    }

    pure function row-label(row: [StandardListViewItem]) -> string {
        // Up to 24 columns (Slint has no loops in expressions).
        (row.length > 0 && columns.length > 0 && columns[0].width >= 0 ? row[0].text : "") + (columns.length > 1 && row.length > 1 && columns[1].width >= 0 ? ", " + columns[1].title + " " + row[1].text : "") + (columns.length > 2 && row.length > 2 && columns[2].width >= 0 ? ", " + columns[2].title + " " + row[2].text : "") + (columns.length > 3 && row.length > 3 && columns[3].width >= 0 ? ", " + columns[3].title + " " + row[3].text : "") + (columns.length > 4 && row.length > 4 && columns[4].width >= 0 ? ", " + columns[4].title + " " + row[4].text : "") + (columns.length > 5 && row.length > 5 && columns[5].width >= 0 ? ", " + columns[5].title + " " + row[5].text : "") + (columns.length > 6 && row.length > 6 && columns[6].width >= 0 ? ", " + columns[6].title + " " + row[6].text : "") + (columns.length > 7 && row.length > 7 && columns[7].width >= 0 ? ", " + columns[7].title + " " + row[7].text : "") + (columns.length > 8 && row.length > 8 && columns[8].width >= 0 ? ", " + columns[8].title + " " + row[8].text : "") + (columns.length > 9 && row.length > 9 && columns[9].width >= 0 ? ", " + columns[9].title + " " + row[9].text : "") + (columns.length > 10 && row.length > 10 && columns[10].width >= 0 ? ", " + columns[10].title + " " + row[10].text : "") + (columns.length > 11 && row.length > 11 && columns[11].width >= 0 ? ", " + columns[11].title + " " + row[11].text : "") + (columns.length > 12 && row.length > 12 && columns[12].width >= 0 ? ", " + columns[12].title + " " + row[12].text : "") + (columns.length > 13 && row.length > 13 && columns[13].width >= 0 ? ", " + columns[13].title + " " + row[13].text : "") + (columns.length > 14 && row.length > 14 && columns[14].width >= 0 ? ", " + columns[14].title + " " + row[14].text : "") + (columns.length > 15 && row.length > 15 && columns[15].width >= 0 ? ", " + columns[15].title + " " + row[15].text : "") + (columns.length > 16 && row.length > 16 && columns[16].width >= 0 ? ", " + columns[16].title + " " + row[16].text : "") + (columns.length > 17 && row.length > 17 && columns[17].width >= 0 ? ", " + columns[17].title + " " + row[17].text : "") + (columns.length > 18 && row.length > 18 && columns[18].width >= 0 ? ", " + columns[18].title + " " + row[18].text : "") + (columns.length > 19 && row.length > 19 && columns[19].width >= 0 ? ", " + columns[19].title + " " + row[19].text : "") + (columns.length > 20 && row.length > 20 && columns[20].width >= 0 ? ", " + columns[20].title + " " + row[20].text : "") + (columns.length > 21 && row.length > 21 && columns[21].width >= 0 ? ", " + columns[21].title + " " + row[21].text : "") + (columns.length > 22 && row.length > 22 && columns[22].width >= 0 ? ", " + columns[22].title + " " + row[22].text : "") + (columns.length > 23 && row.length > 23 && columns[23].width >= 0 ? ", " + columns[23].title + " " + row[23].text : "")
    }

    VerticalLayout {
      // The header scrolls sideways with the rows (and stays on top).
      Rectangle {
        clip: true;
        height: header.height;
        header := AccessTableHeader {
            x: view.content-x;
            width: max(parent.width, self.needed-width);
            columns <=> root.columns;
            reveal-x(x, w) => { view.reveal-x(x, w); }
            column-toggled(c, on) => {
                announce(columns[c].title + ", " + (on ? AccessTableTexts.column-shown : AccessTableTexts.column-hidden));
            }
            menu-requested(c, x) => {
                menu-col = c;
                column-menu.open(x + view.content-x, header.height);
            }
            move-column(f, t) => {
                root.move-column(f, t);
                if (current-column == f) { current-column = t; }
                announce(columns[t].title + ", " + AccessTableTexts.column-position(t + 1, columns.length));
            }
            fit-column(i, tw) => {
                // Every cell on screen of column i says how wide its text is.
                fit-col = i;
                fit-max = tw;
                fit-tick += 1;
                fit-apply.stop();
                fit-apply.start();
            }
            sort-ascending(i) => {
                root.sort-ascending(i);
                announce(columns[i].title + ", " + AccessTableTexts.sorted-ascending);
            }
            sort-descending(i) => {
                root.sort-descending(i);
                announce(columns[i].title + ", " + AccessTableTexts.sorted-descending);
            }
            sort-changed(l) => {
                root.sort-changed(l);
                // Several levels: say them all ("Type, sorted ascending,
                // then Size, sorted descending").
                if (l.length > 1) { announce(sort-words(l)); }
            }
        }
        // The first column's header stays in place, like its cells.
        Rectangle {
            visible: frozen && view.content-x < 0;
            x: 0;
            width: header.first-width;
            background: Palette.alternate-background;
            Text {
                x: 8px;
                width: parent.width - 32px;
                text: columns.length > 0 ? columns[0].title : "";
                font-weight: 600;
                color: Palette.foreground;
                vertical-alignment: center;
                overflow: elide;
                accessible-role: none;
            }
            Text {
                x: parent.width - 24px;
                text: header.arrow-for(0);
                color: Palette.foreground;
                vertical-alignment: center;
                accessible-role: none;
            }
            TouchArea { clicked => { header.sort-by(0); } }
            Rectangle { x: parent.width - 1px; width: 1px; background: Palette.border; }
        }
      }
        view := AccessTableView {
            label: root.label;
            count: loading ? 0 : rows.length;
            density: root.density;
            content-min-width: header.needed-width;
            covered-left: frozen ? header.first-width : 0;
            current-changed(i) => { root.current-row-changed(i); }
            find(p, f) => { root.find(p, f) }
            rows-needed(f, c) => { root.rows-needed(f, c); }

            for k in view.slots : r := AccessRow {
                property <int> n: view.first + k;
                property <[StandardListViewItem]> cells: rows[n];
                property <bool> waiting: cells.length == 0;
                state: view.state;
                index: n;
                label: waiting ? AccessTableTexts.loading : row-label(cells);
                selected: multi-select ? (n < selected-rows.length && selected-rows[n]) : n == view.current;
                navigate(i, m) => {
                    view.go-to(i);
                    if (multi-select && !m.control) {
                        let c = select(view.current, m.shift ? AccessSelect.extend : AccessSelect.only);
                        if (m.shift) { announce(AccessTableTexts.selected-count(c)); }
                    }
                    // Ctrl alone: only the focus moves; Space or Ctrl+click toggles.
                }
                select-all => {
                    if (multi-select) { announce(AccessTableTexts.selected-count(select(-1, AccessSelect.all))); }
                }
                copy => {
                    let c = root.copy(view.current);
                    if (c > 0) { announce(AccessTableTexts.copied-count(c)); }
                }
                toggled(i) => {
                    if (multi-select) { announce(AccessTableTexts.selected-count(select(i, AccessSelect.toggle))); }
                }
                activated(i) => { root.row-activated(i); }
                context-menu(i, x, y) => {
                    if (row-menu.length > 0) {
                        menu-row = i;
                        // Under the row (or at the mouse), in table coordinates.
                        row-menu-box.open(x + 8px, header.height + i * view.state.row-height + view.content-y + y);
                    } else {
                        root.row-context-menu(i, x, y);
                    }
                }
                typed(t) => { view.type-ahead(t); }
                focus-changed(f) => { view.active = f; }
                horizontal(d) => {
                    current-column = header.next-shown(current-column, d);
                    // Read just that cell: "Size, 2 MB".
                    announce(columns[current-column].title + ", " + (waiting ? AccessTableTexts.loading : rows[view.current][current-column].text));
                }

                escape => { hide-tip() }

                HorizontalLayout {
                    for col[c] in columns : cell := Rectangle {
                        visible: col.width >= 0;
                        min-width: col.width < 0 ? 0 : col.width >= 1px ? col.width : max(col.min-width, 32px);
                        max-width: col.width < 0 ? 0 : col.width >= 1px ? col.width : 100000px;
                        horizontal-stretch: col.width < 0 ? 0 : col.width >= 1px ? 0 : max(col.horizontal-stretch, 0.0001);

                        // Cut-off text gets a tooltip with all of it, with
                        // the mouse (after a moment) and with the keyboard
                        // (the cell chosen with Left/Right, at once).
                        property <bool> cut: t.preferred-width > t.width + 0.5px;
                        property <bool> by-mouse: r.hovering && r.hover-x >= self.x && r.hover-x < self.x + self.width;
                        property <bool> by-key: c == current-column && n == view.current && view.active && AccessFocus.show;
                        property <bool> wants-tip: cut && !waiting && (by-mouse || by-key);
                        property <int> tip-id: n * 1000 + c;
                        // The cell chosen with Left/Right scrolls into view
                        // sideways.
                        changed by-key => { if (by-key) { view.reveal-x(self.x, self.width); } }
                        property <int> fit-ticks: fit-tick;
                        changed fit-ticks => {
                            if (c == fit-col && !waiting) { fit-max = max(fit-max, t.preferred-width + 17px); }
                        }
                        changed wants-tip => {
                            if (wants-tip) {
                                offer-tip(tip-id, t.text, self.absolute-position.x - root.absolute-position.x,
                                    self.absolute-position.y - root.absolute-position.y + self.height, self.width, by-key);
                            } else {
                                withdraw-tip(tip-id);
                            }
                        }

                        t := Text {
                            x: 8px;
                            width: parent.width - 16px;
                            // Not loaded yet: "Loading…" in the first column,
                            // a grey bar in the others (a skeleton).
                            text: waiting ? (c == 0 ? AccessTableTexts.loading : "") : c < cells.length ? cells[c].text : "";
                            color: r.text-color;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                        Rectangle {
                            visible: waiting && c > 0;
                            x: 8px;
                            width: min(80px, parent.width - 16px);
                            height: 8px;
                            border-radius: 4px;
                            background: Palette.border;
                        }
                        // The cell chosen with Left/Right: an underline, so
                        // not by colour alone (WCAG 1.4.1).
                        Rectangle {
                            visible: c == current-column && n == view.current && view.active && AccessFocus.show;
                            y: parent.height - 3px;
                            x: 6px;
                            width: parent.width - 12px;
                            height: 2px;
                            background: r.text-color;
                        }
                    }
                }

                // The first cell again, kept in place while the row scrolls
                // sideways (a frozen column). Always there, `visible` only:
                // changing the elements under a focused row confuses screen
                // readers.
                Rectangle {
                    visible: frozen && view.content-x < 0;
                    x: -view.content-x;
                    width: header.first-width;
                    background: Palette.background;
                    Rectangle {
                        background: r.background;
                        Text {
                            x: 8px;
                            width: parent.width - 16px;
                            text: waiting ? AccessTableTexts.loading : cells.length > 0 ? cells[0].text : "";
                            color: r.text-color;
                            vertical-alignment: center;
                            overflow: elide;
                            accessible-role: none;
                        }
                    }
                    Rectangle { x: parent.width - 1px; width: 1px; background: Palette.border; }
                }
            }
        }
    }

    // Fitting a column (double click on its edge, or Ctrl and +): the
    // widest of its title and its cells on screen, at most 600 px.
    property <int> fit-col: -1;
    property <length> fit-max;
    property <int> fit-tick;
    fit-apply := Timer {
        interval: 30ms;
        running: false;
        triggered => {
            self.stop();
            if (fit-col >= 0 && fit-col < columns.length) {
                columns[fit-col].width = min(600px, max(columns[fit-col].min-width, fit-max));
            }
        }
    }

    // The tooltip for cut-off text (WCAG 1.4.13): shown after 0.6 s with
    // the mouse or at once with the keyboard, stays while the mouse is on it,
    // Escape closes it. Only for sighted users: a screen reader already
    // hears the whole text in the row.
    property <int> tip-for: -1;
    property <int> tip-pending: -1;
    property <string> tip-text;
    property <length> tip-x;
    property <length> tip-y;
    property <length> tip-min-width;
    property <bool> tip-shown;
    property <int> tip-closed: -1;

    function offer-tip(id: int, text: string, x: length, y: length, w: length, now: bool) {
        if (id == tip-closed) { return; }
        tip-pending = id;
        tip-text = text;
        tip-x = x;
        tip-y = y;
        tip-min-width = w;
        if (now) {
            tip-for = id;
            tip-shown = true;
            tip-delay.stop();
        } else {
            tip-shown = false;
            if (tip-delay.running) { tip-delay.restart(); } else { tip-delay.start(); }
        }
    }
    function withdraw-tip(id: int) {
        if (id == tip-closed) { tip-closed = -1; }
        if (id != tip-pending && id != tip-for) { return; }
        // Moving onto the tooltip itself keeps it (hoverable).
        if (tip-area.has-hover) { return; }
        tip-pending = -1;
        tip-for = -1;
        tip-shown = false;
        tip-delay.stop();
    }
    // Escape: close it, and keep it closed for this cell until it is left.
    function hide-tip() -> bool {
        if (!tip-shown) { return false; }
        tip-closed = tip-for;
        tip-shown = false;
        tip-for = -1;
        return true;
    }
    tip-delay := Timer {
        interval: 600ms;
        running: false;
        triggered => {
            self.stop();
            if (tip-pending >= 0) {
                tip-for = tip-pending;
                tip-shown = true;
            }
        }
    }

    // No rows, or still loading: say so, in the table and out loud.
    Rectangle {
        y: header.height;
        height: parent.height - header.height;
        visible: loading || rows.length == 0;
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            Text {
                text: loading ? AccessTableTexts.loading : empty-text;
                color: Palette.foreground;
                vertical-alignment: center;
                accessible-role: AccessibleRole.text;
            }
        }
    }
    changed loading => {
        announce(loading ? AccessTableTexts.loading : (rows.length == 0 ? empty-text : rows.length + " " + AccessTableTexts.items));
    }

    // Announcements (WCAG 4.1.3): a cell read with Left/Right.
    cell-news := Text {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        color: transparent;
        accessible-role: AccessibleRole.text;
        accessible-label: self.text;
        accessible-live-region: polite;
    }

    // The tooltip itself, on top of everything; kept inside the table.
    tip := Rectangle {
        visible: tip-shown;
        x: max(0, min(tip-x, root.width - self.width - 2px));
        y: tip-y + self.height > root.height ? max(0, tip-y - self.height - 36px) : tip-y;
        width: min(max(tip-min-width, tip-label.preferred-width + 16px), min(480px, root.width - 4px));
        height: tip-label.preferred-height + 10px;
        background: Palette.foreground;
        border-radius: 4px;
        drop-shadow-blur: 6px;
        drop-shadow-color: #0004;
        accessible-role: none;
        tip-area := TouchArea { }
        tip-label := Text {
            x: 8px;
            y: 5px;
            width: parent.width - 16px;
            text: tip-text;
            wrap: word-wrap;
            color: Palette.background;
            accessible-role: none;
        }
    }
    // The row menu, on top of the table.
    property <int> menu-row: 0;
    row-menu-box := AccessMenu {
        width: root.width;
        height: root.height;
        items: row-menu;
        label: menu-row < rows.length && rows[menu-row].length > 0 ? rows[menu-row][0].text : "";
        activated(i) => { root.row-menu-activated(menu-row, i); }
        // Back to the row once the menu is really gone (giving the focus
        // while its items still hold it does not stick).
        closed => { back-to-row.start(); }
    }
    back-to-row := Timer {
        interval: 1ms;
        running: false;
        triggered => {
            self.stop();
            view.focus-current();
        }
    }

    // The column menu, on top of the table.
    property <int> menu-col: 0;
    column-menu := ColumnMenu {
        width: root.width;
        height: root.height;
        columns: root.columns;
        column: menu-col;
        sortable: true;
        can-add-sort: header.sort-column >= 0 && header.level-of(menu-col) == 0;
        can-hide: header.shown-count > 1;
        label: menu-col < columns.length ? columns[menu-col].title + ", " + AccessTableTexts.column-menu : "";
        activated(i) => { header.menu-action(menu-col, i); }
        closed => { header.focus-header(); }
    }

    // Leaving the tooltip with the mouse closes it (unless the keyboard
    // brought it up).
    property <bool> on-tip: tip-area.has-hover;
    changed on-tip => {
        if (!on-tip && tip-shown && !tip-delay.running) {
            tip-shown = false;
            tip-for = -1;
            tip-pending = -1;
        }
    }
}
