//
// Cells for inside an `AccessRow`. They look like controls but never take
// focus: a table has one Tab stop, and the row handles the keys (Space,
// Delete, the context menu). What they show must also be in the row's
// `label`, so a screen reader hears it.

import { Palette } from "std-widgets.slint";

// Status colours for rows and messages, light and dark (the "success",
// "warning" and "error" backgrounds of Microsoft Fluent 2). Normal text
// stays readable on them (contrast at least 4.5:1). Never use them alone:
// also say it in words ("✓ Arrived").
export global AccessColors {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> success-background: dark ? #393D1B : #DFF6DD;
    out property <brush> warning-background: dark ? #433519 : #FFF4CE;
    out property <brush> error-background: dark ? #442726 : #FDE7E9;
    out property <brush> info-background: dark ? #082338 : #EBF3FC;
    // Icons and edges on those backgrounds (Fluent 2 status colours; 3:1
    // or more against them, WCAG 1.4.11).
    out property <brush> success-foreground: dark ? #54B054 : #0E700E;
    out property <brush> warning-foreground: dark ? #F98845 : #8A3707;
    out property <brush> error-foreground: dark ? #DC626D : #B10E1C;
    out property <brush> info-foreground: dark ? #479EF5 : #0F6CBD;
    // Thin decorative lines (a tree's indent guides): the text colour, faint,
    // so they follow light, dark and high-contrast palettes.
    out property <brush> guide: Palette.foreground.transparentize(0.72);

    // Selected items (rows, tree rows, menu items, suggestions), worked out
    // from the active style's palette so that the selection is seen in every
    // style, light, dark and high contrast: the fill has 3:1 or more against
    // the list's background (WCAG 1.4.11) and its text 4.5:1 or more against
    // the fill (WCAG 1.4.3).
    // - `selection-*`: while the list has the focus. The style's own
    //   selection colour when it reaches 3:1 (fluent, cosmic); otherwise
    //   (the half-transparent selections of cupertino and material) the
    //   accent colour.
    // - `inactive-selection-*`: while the focus is elsewhere. Grey, as in
    //   File Explorer, Finder and GTK, but never so light that it vanishes:
    //   with the normal text colour when 3:1 and 4.5:1 both fit, otherwise
    //   darker (lighter in dark mode) with black or white text.
    out property <color> selection-background: own-selection-ok ? own-selection : opaque(Palette.accent-background);
    out property <color> selection-foreground: own-selection-ok ? opaque(Palette.selection-foreground) : black-or-white(selection-background);
    out property <color> inactive-selection-background: grey(fill);
    out property <color> inactive-selection-foreground: fits-with-text ? text : black-or-white(inactive-selection-background);

    // WCAG relative luminance and contrast ratio.
    pure public function luminance(c: color) -> float {
        0.2126 * linear(c.red) + 0.7152 * linear(c.green) + 0.0722 * linear(c.blue)
    }
    pure public function contrast(a: color, b: color) -> float {
        (max(luminance(a), luminance(b)) + 0.05) / (min(luminance(a), luminance(b)) + 0.05)
    }
    pure function linear(v: int) -> float {
        v / 255 <= 0.04045 ? v / 255 / 12.92 : pow((v / 255 + 0.055) / 1.055, 2.4)
    }
    // A colour as drawn on the list's background (styles use see-through
    // colours).
    pure function opaque(c: color) -> color {
        rgb(c.red * c.alpha / 255 + base.red * (1 - c.alpha / 255),
            c.green * c.alpha / 255 + base.green * (1 - c.alpha / 255),
            c.blue * c.alpha / 255 + base.blue * (1 - c.alpha / 255))
    }
    // The grey with luminance `l`.
    pure function grey(l: float) -> color {
        let v = l <= 0.0031308 ? 12.92 * l : 1.055 * pow(l, 1 / 2.4) - 0.055;
        rgb(v * 255, v * 255, v * 255)
    }
    pure function black-or-white(c: color) -> color {
        contrast(c, #000000) >= contrast(c, #ffffff) ? #000000 : #ffffff
    }

    property <color> base: Palette.background;
    property <color> own-selection: opaque(Palette.selection-background);
    property <bool> own-selection-ok: contrast(own-selection, base) >= 3;
    property <color> text: opaque(Palette.foreground);
    property <float> lb: luminance(base);
    property <float> lt: luminance(text);
    property <bool> light: lb > lt;
    // A little over 3:1 and 4.5:1, so rounding to whole colour values never
    // drops below them.
    property <float> fill-ratio: 3.1;
    property <float> text-ratio: 4.6;
    // The fill closest to the background that still has 3:1 against it;
    // the normal text stays on it when that is still 4.5:1 away.
    property <float> fill: max(0, min(1, light ? (lb + 0.05) / fill-ratio - 0.05 : fill-ratio * (lb + 0.05) - 0.05));
    property <bool> fits-with-text: light ? text-ratio * (lt + 0.05) - 0.05 <= fill : (lt + 0.05) / text-ratio - 0.05 >= fill;
}

// A check box look (e.g. "selected"). 16 px box inside a 24 px area (WCAG
// 2.5.8); a tick, not colour alone (WCAG 1.4.1).
export component AccessCheckCell inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled();
    min-width: 24px;
    min-height: 24px;
    accessible-role: none;

    box := Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 3px;
        border-width: 1px;
        border-color: enabled ? Palette.foreground : Palette.border;
        background: checked && enabled ? Palette.accent-background : transparent;
        opacity: enabled ? 1 : 0.5;
        Text {
            text: checked ? "✓" : "";
            color: Palette.accent-foreground;
            font-size: 12px;
            horizontal-alignment: center;
            vertical-alignment: center;
            accessible-role: none;
        }
    }
    TouchArea {
        enabled: root.enabled;
        clicked => { toggled(); }
    }
}

// A progress bar with its text next to it ("45 %", "Paused"). The text
// says what the bar shows, so it is never colour or length alone.
export component AccessProgressCell inherits Rectangle {
    // 0.0 … 1.0
    in property <float> progress;
    in property <string> text;
    // Paused or failed: a calmer bar.
    in property <bool> muted;
    in property <brush> text-color: Palette.foreground;
    min-width: 120px;
    accessible-role: none;

    HorizontalLayout {
        spacing: 8px;
        alignment: stretch;
        Rectangle {
            height: 6px;
            y: (parent.height - self.height) / 2;
            horizontal-stretch: 1;
            min-width: 60px;
            border-radius: 3px;
            background: Palette.alternate-background;
            border-width: 1px;
            border-color: Palette.border;
            Rectangle {
                x: 0;
                width: parent.width * max(0, min(1, progress));
                border-radius: 3px;
                background: muted ? Palette.border : Palette.accent-background;
            }
        }
        Text {
            text: root.text;
            color: root.text-color;
            vertical-alignment: center;
            min-width: 70px;
            accessible-role: none;
        }
    }
}

// Plain text in a cell: elides when too long.
export component AccessTextCell inherits Rectangle {
    in property <string> text;
    in property <TextHorizontalAlignment> align: left;
    // Pass the row's `text-color`, so text stays readable on a selected row.
    in property <brush> text-color: Palette.foreground;
    accessible-role: none;
    Text {
        x: 8px;
        width: parent.width - 16px;
        text: root.text;
        horizontal-alignment: align;
        vertical-alignment: center;
        overflow: elide;
        color: root.text-color;
        accessible-role: none;
    }
}

// Says something out loud without showing it: a status message (WCAG 4.1.3),
// e.g. "12 files sent". Saying the same thing twice is heard twice.
export component AccessAnnouncer inherits Rectangle {
    property <bool> flip;
    // Read when the screen reader is done with what it is saying.
    public function say(t: string) {
        flip = !flip;
        news.text = t + (flip ? "" : " ");
    }
    // Read at once, interrupting: only for errors and warnings that need
    // attention now.
    public function say-now(t: string) {
        flip = !flip;
        urgent.text = t + (flip ? "" : " ");
    }
    width: 1px;
    height: 1px;
    news := Text {
        color: transparent;
        accessible-role: AccessibleRole.text;
        accessible-label: self.text;
        accessible-live-region: polite;
    }
    urgent := Text {
        color: transparent;
        accessible-role: AccessibleRole.text;
        accessible-label: self.text;
        accessible-live-region: assertive;
    }
}
