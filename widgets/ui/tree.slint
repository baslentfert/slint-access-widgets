// SPDX-License-Identifier: MIT OR Apache-2.0
//
// A tree (folders, groups), as in the WAI-ARIA Authoring Practices: one Tab
// stop; Up/Down/Home/End over the visible rows; Right opens a closed node
// or goes to its first child; Left closes an open node or goes to its
// parent; Enter activates; letters jump. Built on the table's building
// blocks: only the rows on screen exist, and every row takes the focus
// itself.
//
// The rows are the visible nodes, flattened; `slint_access_widgets::TreeRows`
// (Rust) keeps them: it opens and closes nodes, loads children when a node
// is first opened (so they can come from another computer), and answers
// `parent-of`.

import { Palette } from "std-widgets.slint";
import { AccessTableView, AccessRow } from "table.slint";
import { AccessAnnouncer, AccessColors } from "cells.slint";
import { AccessFocus } from "focus.slint";

// A built-in icon before the text, drawn by the tree (no image files): a
// folder (open while expanded) or a file.
export enum AccessTreeIcon { none, folder, file }

// Thin vertical lines, one per level, from a node down along its children
// (as the indent guides of VS Code; off in File Explorer, Finder and GTK).
export enum AccessIndentGuides { none, on-hover, always }

export struct AccessTreeRow {
    text: string,
    // 1 for the top level.
    level: int,
    has-children: bool,
    expanded: bool,
    // Icons only show; screen readers don't read them (the kind should be in
    // the text or follow from "expanded"/"collapsed"). `image` is your own
    // (shown at 16 × 16 px) and wins over `icon` when set.
    icon: AccessTreeIcon,
    image: image,
}

export global AccessTreeTexts {
    pure public function level(n: int) -> string {
        @tr("access-widgets" => "level {}", n)
    }
    in-out property <string> expanded: @tr("access-widgets" => "expanded");
    in-out property <string> collapsed: @tr("access-widgets" => "collapsed");
    in-out property <string> empty: @tr("access-widgets" => "Empty");
    pure public function expanded-count(n: int) -> string {
        @tr("access-widgets" => "expanded, {n} item" | "expanded, {n} items" % n)
    }
}

// The built-in icons, 16 × 16 px, drawn as paths: a yellow folder (as in
// File Explorer and Finder, light and dark), a page with a folded corner in
// the text colour.
component TreeGlyph inherits Path {
    in property <AccessTreeIcon> icon;
    in property <bool> open;
    in property <brush> ink;
    property <bool> folder: icon == AccessTreeIcon.folder;
    width: 16px;
    height: 16px;
    viewbox-width: 16;
    viewbox-height: 16;
    accessible-role: none;
    commands: !folder ? "M3.5 1.5 L9.5 1.5 L12.5 4.5 L12.5 14.5 L3.5 14.5 Z M9.5 1.5 L9.5 4.5 L12.5 4.5"
        // Open: the back with its tab, and the front tilted open.
        : open ? "M1.5 12.5 L1.5 3.5 C1.5 2.95 1.95 2.5 2.5 2.5 L6 2.5 L7.5 4 L12.5 4 C13.05 4 13.5 4.45 13.5 5 L13.5 6.5 M1.5 12.5 L3.5 7.2 C3.65 6.8 4 6.5 4.45 6.5 L14.6 6.5 C15.1 6.5 15.45 7 15.25 7.45 L13.25 12.9 C13.1 13.25 12.8 13.5 12.4 13.5 L2.5 13.5 C1.95 13.5 1.5 13.05 1.5 12.5 Z"
        : "M1.5 3.5 C1.5 2.95 1.95 2.5 2.5 2.5 L6 2.5 L7.5 4 L13.5 4 C14.05 4 14.5 4.45 14.5 5 L14.5 12.5 C14.5 13.05 14.05 13.5 13.5 13.5 L2.5 13.5 C1.95 13.5 1.5 13.05 1.5 12.5 Z";
    fill: folder ? (AccessColors.dark ? #E8B84F : #EAB23F) : transparent;
    stroke: folder ? (AccessColors.dark ? #F3CE7A : #B9861C) : ink;
    stroke-width: 1px;
}

export component AccessTree inherits Rectangle {
    // What a screen reader calls the tree, e.g. "Folders".
    in property <string> label;
    in property <[AccessTreeRow]> rows;
    in-out property <int> current-row <=> view.current;
    // Open or close the node in this row (`TreeRows::expand`/`collapse`);
    // return how many rows it has under it now (for the announcement).
    callback expand(row: int) -> int;
    callback collapse(row: int);
    // The row of the parent of this row, -1 at the top level.
    callback parent-of(row: int) -> int;
    // Enter or double click.
    callback activated(row: int);
    // Type-ahead: as `AccessTable.find`.
    callback find(prefix: string, from: int) -> int;
    // Lines along the levels: never (the default, as most file managers),
    // while the mouse is on the tree or it has the focus, or always.
    in property <AccessIndentGuides> indent-guides: none;

    public function focus-current() { view.focus-current(); }

    // "expanded" doesn't reach AT-SPI yet (AccessKit #824): on Linux we say
    // it in the description and announce it.
    property <bool> zeg-het: Platform.os != OperatingSystemType.windows && Platform.os != OperatingSystemType.macos;

    function open(i: int) {
        if (i < 0 || i >= rows.length || !rows[i].has-children || rows[i].expanded) { return; }
        let n = expand(i);
        // Empty after all: say so everywhere (it doesn't open).
        if (n == 0) { news.say(AccessTreeTexts.empty); }
        else if (zeg-het) { news.say(AccessTreeTexts.expanded-count(n)); }
    }
    function shut(i: int) {
        if (i < 0 || i >= rows.length || !rows[i].expanded) { return; }
        collapse(i);
        if (zeg-het) { news.say(AccessTreeTexts.collapsed); }
    }
    function toggle(i: int) {
        if (rows[i].expanded) { shut(i); } else { open(i); }
    }

    background: Palette.background;
    border-width: 1px;
    border-color: Palette.border;
    min-height: 120px;
    // Fill the space it gets, as a table does.
    vertical-stretch: 1;
    horizontal-stretch: 1;

    property <bool> guides: indent-guides == AccessIndentGuides.always
        || (indent-guides == AccessIndentGuides.on-hover && (hover.has-hover || view.active));

    // Around everything, so the mouse anywhere on the rows counts.
    hover := TouchArea {
        view := AccessTableView {
            label: root.label;
            count: rows.length;
            find(p, f) => { root.find(p, f) }

            for k in view.slots : r := AccessRow {
                property <int> n: view.row-of(k);
                property <AccessTreeRow> node: rows[n];
                state: view.state;
                index: n;
                label: node.text;
                expandable: node.has-children;
                expanded: node.expanded;
                description: AccessTreeTexts.level(node.level)
                    + (zeg-het && node.has-children ? ", " + (node.expanded ? AccessTreeTexts.expanded : AccessTreeTexts.collapsed) : "");
                navigate(i, m) => { view.go-to(i); }
                focus-changed(f) => { view.active = f; }
                typed(t) => { view.type-ahead(t); }
                activated(i) => { root.activated(i); }
                toggled(i) => { toggle(i); }
                horizontal(d) => {
                    if (d > 0) {
                        // Right: open, or into the first child.
                        if (node.has-children && !node.expanded) { open(n); }
                        else if (node.expanded && n + 1 < rows.length) { view.go-to(n + 1); }
                    } else {
                        // Left: close, or up to the parent.
                        if (node.expanded) { shut(n); }
                        else {
                            let p = parent-of(n);
                            if (p >= 0) { view.go-to(p); }
                        }
                    }
                }

                // One guide per level above this row, under the triangle of the
                // node it belongs to; on a selected row in the row's text colour.
                for j in (root.guides ? node.level - 1 : 0) : Rectangle {
                    x: 6px + j * 20px + 9.5px;
                    width: 1px;
                    height: r.height;
                    background: r.selected ? r.text-color.transparentize(0.5) : AccessColors.guide;
                    accessible-role: none;
                }
                HorizontalLayout {
                    padding-left: 6px + (node.level - 1) * 20px;
                    spacing: 4px;
                    // The triangle: click to open or close.
                    Rectangle {
                        width: 20px;
                        Text {
                            text: !node.has-children ? "" : node.expanded ? "▾" : "▸";
                            color: r.text-color;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            accessible-role: none;
                        }
                        TouchArea {
                            enabled: node.has-children;
                            clicked => {
                                AccessFocus.keyboard = false;
                                view.go-to(n);
                                toggle(n);
                            }
                        }
                    }
                    if node.image.width > 0 || node.icon != AccessTreeIcon.none: VerticalLayout {
                        alignment: center;
                        if node.image.width > 0: Image {
                            source: node.image;
                            width: 16px;
                            height: 16px;
                            image-fit: contain;
                            accessible-role: none;
                        }
                        if node.image.width == 0: TreeGlyph {
                            icon: node.icon;
                            open: node.expanded;
                            ink: r.text-color;
                            // Here too: on the component's own root alone it
                            // still showed up as an empty node over AT-SPI.
                            accessible-role: none;
                        }
                    }
                    Text {
                        text: node.text;
                        color: r.text-color;
                        vertical-alignment: center;
                        overflow: elide;
                        accessible-role: none;
                    }
                }
            }
        }
    }
    news := AccessAnnouncer { }
}
