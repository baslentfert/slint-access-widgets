import { AccessTable, AccessFilter, AccessDensity, AccessSort, AccessAnnouncer } from "@access-widgets";
import { Button, VerticalBox, HorizontalBox, ComboBox } from "std-widgets.slint";

export component AppWindow inherits Window {
    title: "Access widgets";
    preferred-width: 820px;
    preferred-height: 520px;
    in property <[[StandardListViewItem]]> files;
    in property <[bool]> selected;
    in property <int> total;
    in property <bool> loading;
    in-out property <[TableColumn]> columns: [
        { title: @tr("Name"), horizontal-stretch: 3, min-width: 200px },
        { title: @tr("Size"), horizontal-stretch: 1, min-width: 80px },
        { title: @tr("Modified"), horizontal-stretch: 1, min-width: 100px },
        { title: @tr("Type"), horizontal-stretch: 1, min-width: 140px },
        { title: @tr("Folder"), horizontal-stretch: 2, min-width: 200px },
        { title: @tr("Owner"), horizontal-stretch: 1, min-width: 90px },
    ];
    in-out property <string> status;
    property <AccessDensity> density: density-box.current-index == 0 ? AccessDensity.compact : density-box.current-index == 2 ? AccessDensity.comfortable : AccessDensity.standard;
    // The whole sort, first level first (Shift+click adds levels).
    callback sort-changed([AccessSort]);
    callback move-column(int, int);
    callback find(string, int) -> int;
    callback select(int, int) -> int;
    callback copy(int) -> int;
    in-out property <int> current-row <=> table.current-row;
    public function keep-current(i: int) { table.keep-current-row(i); }
    callback filter(string);
    callback reload();

    VerticalBox {
        HorizontalBox {
            padding: 0;
            AccessFilter {
                label: @tr("Filter files");
                shown: files.length;
                total: total;
                edited(t) => { root.filter(t); }
            }
            Text { text: @tr("Rows"); vertical-alignment: center; }
            density-box := ComboBox {
                accessible-label: @tr("Rows");
                model: [@tr("Compact"), @tr("Standard"), @tr("Comfortable")];
                current-index: 1;
            }
            Button { text: @tr("Reload"); clicked => { root.reload(); } }
        }
        table := AccessTable {
            label: @tr("Downloads");
            columns <=> root.columns;
            rows: files;
            density: root.density;
            multi-select: true;
            selected-rows: selected;
            loading: root.loading;
            empty-text: @tr("No files match the filter");
            select(r, h) => { root.select(r, h) }
            copy(c) => { root.copy(c) }
            sort-changed(l) => { root.sort-changed(l); }
            move-column(f, t) => { root.move-column(f, t); }
            find(p, f) => { root.find(p, f) }
            row-activated(i) => { status = @tr("Opened {}", files[i][0].text); }
            // A row menu that screen readers follow.
            row-menu: [
                { title: @tr("Open"), enabled: true },
                { title: @tr("Copy"), enabled: true },
                { title: @tr("Rename"), enabled: false },
                { title: @tr("Delete"), enabled: true, separator: true },
            ];
            row-menu-activated(r, item) => {
                status = (item == 0 ? @tr("Opened {}", files[r][0].text) : item == 1 ? @tr("Copied {}", files[r][0].text) : @tr("Deleted {} (not really)", files[r][0].text));
                news.say(status);
            }
        }
        HorizontalBox {
            padding: 0;
            Button { text: @tr("Go to the table"); clicked => { table.focus-current(); } }
            Text { text: status; vertical-alignment: center; }
        }
    }
    news := AccessAnnouncer { }
}
